  fadeOverlay: {fileID: 781082669}
  fadeDuration: 1.5
  nextSceneName: "Mus\xE9e d'Orsay"
  firstDialogueLines:
  - Good. Your first assignment starts now.
  - "The target is the Mus\xE9e d'Orsay."
  - You know it.
  - Before you head in, check your pocket.
  - I left you something useful.
  - Everything you need is built right into that manual.
  secondDialogueLines:
  - Good. Now, your inventory.
  - Everything you collect will be stored there.
  - Check it often. You'll need it.
  thirdDialogueLines:
  - Good. That covers the basics.
  - Use your tools wisely.
  - Now move.
  typingSpeed: 0.08
  waitAfterLine: 1
  maxTextWidth: 600
  minPanelWidth: 120
  panelPaddingX: 30
  panelPaddingY: 20
