  entries:
  - paintingId: Grande Odalisque
    button: {fileID: 1749993889}
    image: {fileID: 894190751}
    selectionHighlight: {fileID: 1347270780}
    displayName: Grande Odalisque
    description: Grande Odalisque, painted by Jean-Auguste-Dominique Ingres in 1814,
      depicts a reclining odalisque. The work marks his shift from Neoclassicism
      toward a more exotic and Romantic style.
    unlocked: 0
  - paintingId: "La Belle Ferronni\xE8re"
    button: {fileID: 355801661}
    image: {fileID: 474387365}
    selectionHighlight: {fileID: 1410682267}
    displayName: "La Belle Ferronni\xE8re"
    description: "La Belle Ferronni\xE8re is a portrait by Leonardo da Vinci, believed
      to depict Lucrezia Crivelli, a mistress of Duke Ludovico Sforza of Milan."
    unlocked: 0
  - paintingId: Mona Lisa
    button: {fileID: 913035500}
    image: {fileID: 1621064130}
    selectionHighlight: {fileID: 1215051261}
    displayName: Mona Lisa
    description: Mona Lisa is a portrait by Leonardo da Vinci, widely regarded as
      a masterpiece of the Italian Renaissance, known for its enigmatic expression
      and subtle composition.
    unlocked: 0
  - paintingId: "Portrait of Madame R\xE9camier"
    button: {fileID: 1527079579}
    image: {fileID: 822692447}
    selectionHighlight: {fileID: 1714849871}
    displayName: "Portrait of Madame R\xE9camier"
    description: "Portrait of Madame R\xE9camier is an 1800 portrait by Jacques-Louis
      David, depicting Juliette R\xE9camier reclining in a simple Neoclassical setting.
      The work remains unfinished."
    unlocked: 0
  - paintingId: Saint John the Baptist
    button: {fileID: 957539610}
    image: {fileID: 187883744}
    selectionHighlight: {fileID: 276351235}
    displayName: Saint John the Baptist
    description: "Saint John the Baptist is a late work by Leonardo da Vinci, painted
      around 1513\u20131516, known for its dramatic lighting and mysterious expression."
    unlocked: 0
  - paintingId: "Starry Night Over the Rh\xF4ne"
    button: {fileID: 458774733}
    image: {fileID: 1360436818}
    selectionHighlight: {fileID: 1304342718}
    displayName: "Starry Night Over the Rh\xF4ne"
    description: "Starry Night Over the Rh\xF4ne is an 1888 painting by Vincent van
      Gogh, depicting a glowing night scene by the river, with reflections of stars
      shimmering on the water."
    unlocked: 0
  - paintingId: flashlight
    button: {fileID: 1052359453}
    image: {fileID: 1167673945}
    selectionHighlight: {fileID: 0}
    displayName: Flash Light
    description: Useful tool for lighting
    unlocked: 0
